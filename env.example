
# Database
DB_FILE=task_engine.db

# API security — replace with a long random secret in deployment
ENGINE_API_KEY=replace-with-a-random-secret

# Consumer — safe default
DRY_RUN=true
TASK_SUBMISSION_URL=
TASK_SUBMISSION_TOKEN=

# Worker tuning
POLL_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_TARGETS=10
