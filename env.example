DATABASE_URL=postgresql://neondb_owner:npg_2x7qYKoXPwrh@ep-polished-unit-b511m9w5-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# --------------------------------------------------
# API SECURITY & AUTHENTICATION
# Replace with a long random secret in production deployment
# --------------------------------------------------
ENGINE_API_KEY=replace-with-a-random-secret


# --------------------------------------------------
# CONSUMER SETTINGS
# DRY_RUN=true prevents accidental external submissions during testing
# --------------------------------------------------
DRY_RUN=true
TASK_SUBMISSION_URL=https://httpbin.org/post
TASK_SUBMISSION_TOKEN=


# --------------------------------------------------
# WORKER TUNING (Polymorphic Ingestion Engine)
# --------------------------------------------------
POLL_INTERVAL=15
REQUEST_TIMEOUT=15
MAX_CONCURRENT_TARGETS=10
